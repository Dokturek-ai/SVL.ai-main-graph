# =============================================================================
# Dokturek.ai — LightRAG (SVL) — production configuration reference
# =============================================================================
# This file lists ONLY the variables actually used by the SVL.ai Railway
# deployment, with the production values as defaults. Secrets are placeholders.
#
# Source of truth for production = Railway environment variables (edit them in
# the Railway dashboard / `railway` CLI). This file is a human reference and a
# starting point for a local `.env`. The legacy `make env-*` wizard is NOT used.
#
# The full upstream catalog of every possible variable lives in git history
# (commit c9e3d1bf) and upstream HKUDS/LightRAG if you ever need an option that
# is not listed here.
# =============================================================================

###########################
### Server
###########################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE=SVL
WEBUI_DESCRIPTION=SVL guidelines RAG - Dokturek.ai

### Data directories (Railway volume is mounted at /app/data)
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts

###########################
### API authentication
###########################
### Required to call the API. Send it as the `X-API-Key` header.
### Without it the public endpoint is open to anyone.
LIGHTRAG_API_KEY=your-secure-api-key-here

###########################
### LLM (OpenAI)
###########################
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=your_openai_api_key
LLM_MODEL=gpt-5-mini
### Max concurrent LLM requests (base + per-role overrides)
MAX_ASYNC=4
KEYWORD_MAX_ASYNC_LLM=4
QUERY_MAX_ASYNC_LLM=4

###########################
### Embedding (Jina)
###########################
### NOTE: HOST must be the FULL endpoint `.../v1/embeddings` — the Jina client
### POSTs the host as-is; a bare `.../v1` returns 404 "Invalid endpoint".
### Embedding model/dim must NOT change after the first ingest (vectors would
### no longer match the model's space — would require a full re-ingest).
EMBEDDING_BINDING=jina
EMBEDDING_BINDING_HOST=https://api.jina.ai/v1/embeddings
EMBEDDING_BINDING_API_KEY=your_jina_api_key
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true
### Chunks per embedding request
EMBEDDING_BATCH_NUM=32

###########################
### Reranking (Jina)
###########################
### Default query mode is `mix`, which uses the reranker.
RERANK_BINDING=jina
RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
RERANK_BINDING_API_KEY=your_jina_api_key
RERANK_MODEL=jina-reranker-v3

###########################
### Storage backends
###########################
### Production uses PostgreSQL (pgvector) for KV/Vector/DocStatus and Neo4j for
### the knowledge graph. All four selectors must point at the DB backends.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage

### --- PostgreSQL (Railway service: pgVector-Railway, private network) ---
POSTGRES_HOST=pgvector-railway.railway.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=railway
POSTGRES_MAX_CONNECTIONS=25
### Vector index: HNSW (pgvector). Tunables below apply to HNSW.
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

### --- Neo4j (Railway service, private network, bolt without TLS on internal) ---
NEO4J_URI=bolt://neo4j-graph-database--metal-ready.railway.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30
NEO4J_MAX_TRANSACTION_RETRY_TIME=30
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_LIVENESS_CHECK_TIMEOUT=30
NEO4J_KEEP_ALIVE=true

###########################
### Document parsing (MinerU)
###########################
### Parser routing by file extension. `*:mineru-it` = MinerU engine with image
### (i) + table (t) modality analysis. Files MinerU can't handle fall back to
### the built-in legacy extractor automatically.
### Fuller multimodal option (per docs): *:native-iteP,*:mineru-iteP,*:legacy-R
LIGHTRAG_PARSER=*:mineru-it

### MinerU runs as a separate Railway service (private network).
MINERU_API_MODE=local
MINERU_LOCAL_ENDPOINT=http://mineru.railway.internal:8000
### Backend: `pipeline` is required because the MinerU service is CPU-only.
### `hybrid-auto-engine`/`vlm-auto-engine` need a GPU and crash on CPU under
### load (libgomp: Thread creation failed).
MINERU_LOCAL_BACKEND=pipeline
### auto = detect embedded text layer vs OCR per page.
MINERU_LOCAL_PARSE_METHOD=auto
MINERU_LOCAL_IMAGE_ANALYSIS=true
### OCR language hint. cs = Czech (SVL documents). latin = Latin-script fallback.
MINERU_LANGUAGE=cs

###########################
### Multimodal / VLM
###########################
### When enabled, images/tables extracted by MinerU are summarized by a VLM.
### No dedicated VLM model is set, so it uses the base LLM (gpt-5-mini, vision).
VLM_PROCESS_ENABLE=true
VLM_MAX_IMAGE_BYTES=5242880

###########################
### Document processing
###########################
### Output language for entity/relation summaries and answers.
SUMMARY_LANGUAGE=Czech
### JSON-structured entity extraction (higher reliability).
ENTITY_EXTRACTION_USE_JSON=true
### Documents processed in parallel (2-10; ~MAX_ASYNC/3 recommended).
MAX_PARALLEL_INSERT=3
