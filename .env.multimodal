# ============================================
# MULTIMODAL RAG CONFIGURATION
# CPU-Only, Agnostic LLM/Embedding, Cohere Reranking
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE=Multimodal RAG Knowledge Base
WEBUI_DESCRIPTION=Advanced RAG with Images, Tables & Formulas
WORKERS=4
TIMEOUT=300

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_URI=neo4j://neo4j:7687

MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MILVUS_URI=http://milvus:19530

# ============================================
# STORAGE CONFIGURATION
# ============================================
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts
MAX_UPLOAD_SIZE=209715200  # 200MB

# ============================================
# MULTIMODAL DOCUMENT PROCESSING
# ============================================

# Parser routing - MinerU for PDFs/Office, Docling as fallback
# i=images, t=tables, e=equations, P=paragraph semantic chunking
LIGHTRAG_PARSER=*:native-iteP,*:mineru-iteP,*:docling-iteP,*:legacy-R

# ---- MinerU Configuration ----
MINERU_API_MODE=local
MINERU_LOCAL_ENDPOINT=http://mineru:8000
MINERU_LOCAL_BACKEND=pipeline
MINERU_LOCAL_PARSE_METHOD=auto
MINERU_LOCAL_IMAGE_ANALYSIS=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_LANGUAGE=en
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_MAX_POLLS=180

# ---- Docling Configuration ----
DOCLING_ENDPOINT=http://docling:5001
DOCLING_DO_OCR=true
DOCLING_FORCE_OCR=true
DOCLING_DO_FORMULA_ENRICHMENT=true
DOCLING_POLL_INTERVAL_SECONDS=5
DOCLING_MAX_POLLS=240

# ---- VLM Configuration (for image/table/formula analysis) ----
# Configure your VLM model here (e.g., gpt-4-vision, claude-3-5-sonnet, etc.)
VLM_LLM_MODEL=gpt-4-vision
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=https://api.openai.com/v1
VLM_LLM_BINDING_API_KEY=sk-...your-api-key...
VLM_MAX_ASYNC_LLM=2
VLM_LLM_TIMEOUT=60

# Multimodal context budget
SURROUNDING_LEADING_MAX_TOKENS=2000
SURROUNDING_TRAILING_MAX_TOKENS=2000

# ============================================
# CHUNKING CONFIGURATION
# ============================================

# Global settings
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

# Paragraph semantic chunker (best for tables)
CHUNK_P_SIZE=2000
CHUNK_P_OVERLAP_SIZE=100

# Semantic vector chunker
CHUNK_V_SIZE=1200
CHUNK_V_BREAKPOINT_THRESHOLD_TYPE=percentile
CHUNK_V_BREAKPOINT_THRESHOLD_AMOUNT=95
CHUNK_V_BUFFER_SIZE=1

# Recursive chunker (fallback)
CHUNK_R_SIZE=1200
CHUNK_R_OVERLAP_SIZE=100
CHUNK_R_SEPARATORS=["\\n\\n","\\n","。","！","？","；","，"," ",""]

# ============================================
# ENTITY EXTRACTION
# ============================================

ENTITY_EXTRACTION_USE_JSON=true
MAX_EXTRACTION_RECORDS=100
MAX_EXTRACTION_ENTITIES=40
MAX_EXTRACT_INPUT_TOKENS=20480
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# Merge configuration
FORCE_LLM_SUMMARY_ON_MERGE=8
SUMMARY_MAX_TOKENS=1200
SUMMARY_LENGTH_RECOMMENDED=600
SUMMARY_CONTEXT_SIZE=12000
SUMMARY_LANGUAGE=English

# ============================================
# LLM CONFIGURATION (AGNOSTIC)
# ============================================

# Main LLM for entity extraction
# Configure your preferred LLM provider:
# - OpenAI: openai
# - Anthropic: anthropic
# - Ollama: ollama
# - Azure: azure_openai
# - Google Gemini: gemini
# - etc.

LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=sk-...your-api-key...
LLM_MODEL=gpt-4-turbo
LLM_TIMEOUT=180
MAX_ASYNC=4

# Role-specific LLM overrides (optional)
EXTRACT_LLM_MODEL=gpt-4-turbo
EXTRACT_MAX_ASYNC_LLM=2

QUERY_LLM_MODEL=gpt-4-turbo
QUERY_MAX_ASYNC_LLM=2

KEYWORD_LLM_MODEL=gpt-4-mini
KEYWORD_MAX_ASYNC_LLM=4

# ============================================
# EMBEDDING CONFIGURATION (AGNOSTIC)
# ============================================

# Configure your preferred embedding provider:
# - OpenAI: openai
# - Ollama: ollama
# - HuggingFace: hf
# - Cohere: cohere
# - etc.

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=sk-...your-api-key...
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_NUM=32
EMBEDDING_FUNC_MAX_ASYNC=8

# ============================================
# RERANKING CONFIGURATION (COHERE)
# ============================================

RERANK_BINDING=cohere
RERANK_MODEL=rerank-v3.5
RERANK_BINDING_HOST=https://api.cohere.com/v2/rerank
RERANK_BINDING_API_KEY=your-cohere-api-key
MIN_RERANK_SCORE=0.5
RERANK_BY_DEFAULT=true
MAX_ASYNC_RERANK=4
RERANK_TIMEOUT=30

# ============================================
# PIPELINE CONFIGURATION
# ============================================

# Parallel processing
MAX_PARALLEL_INSERT=3
MAX_PARALLEL_PARSE_NATIVE=5
MAX_PARALLEL_PARSE_MINERU=2
MAX_PARALLEL_PARSE_DOCLING=2
MAX_PARALLEL_ANALYZE=5

# Queue sizes
QUEUE_SIZE_PARSE=20
QUEUE_SIZE_ANALYZE=100
QUEUE_SIZE_INSERT=4

# ============================================
# QUERY CONFIGURATION
# ============================================

ENABLE_LLM_CACHE=true
COSINE_THRESHOLD=0.2
TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
KG_CHUNK_PICK_METHOD=VECTOR
RELATED_CHUNK_NUMBER=5

# ============================================
# LOGGING & MONITORING
# ============================================

LOG_LEVEL=INFO
VERBOSE=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================
# OPTIONAL: AUTHENTICATION
# ============================================

# Uncomment to enable authentication
# AUTH_ACCOUNTS=admin:admin123
# TOKEN_SECRET=your-secret-key-here
# JWT_ALGORITHM=HS256
# TOKEN_EXPIRE_HOURS=48
# LIGHTRAG_API_KEY=your-api-key-here

# ============================================
# OPTIONAL: REDIS CACHE
# ============================================

REDIS_URI=redis://redis:6379/0

# ============================================
# OPTIONAL: CORS
# ============================================

# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

